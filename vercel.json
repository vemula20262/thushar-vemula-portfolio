{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/out",
  "redirects": [
    { "source": "/projects/:slug*", "destination": "/#work", "permanent": true },
    { "source": "/demos/:path*", "destination": "/#work", "permanent": true },
    { "source": "/resume", "destination": "/resume.html", "permanent": true }
  ]
}
